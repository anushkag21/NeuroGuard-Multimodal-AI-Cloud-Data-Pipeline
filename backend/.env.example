# Copy this file to backend/.env and update your serial and feature flags.

SERIAL_PORT=/dev/cu.usbserial-0001
CAMERA_INDEX=0
BAUD_RATE=115200
TEST_DURATION=180
ENABLE_CAMERA=true
ENABLE_EEG=true
ENABLE_EMG=true
ENABLE_HRV=true
ENABLE_SPO2=true
ENABLE_ADAPTIVE_QUESTIONS=true
GROQ_API_KEY=your_groq_api_key_here
